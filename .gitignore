# Hidden files
.*
!.git*
!.dockerignore

# Dependencies
node_modules/

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
venv/
env/

# Testing
htmlcov/

# Run artifacts
runs/

# OS
Thumbs.db

# The linter plugin is shared, so its settings file is tracked. Re-including the
# directory is required before the file, then everything else there stays local.
!.claude/
.claude/*
!.claude/settings.json
